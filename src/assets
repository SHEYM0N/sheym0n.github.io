  }
  mount(document);
  addEventListener('load', () => $$('.tscale').forEach(fit));

  /* ---------- Language ---------- */
  const langBtn = $('#language'), langText = $('#langText');
  let language = 'fa';
  function splitWords(el) {
    if (!el || reduced) return;
    const text = el.textContent.trim(); el.textContent = '';
    text.split(/\s+/).forEach((w, i, arr) => {
      const s = document.createElement('span'); s.className = 'w'; s.style.setProperty('--i', i); s.textContent = w; el.appendChild(s);
      if (i < arr.length - 1) el.appendChild(document.createTextNode(' '));
    });
  }
  function setLanguage(next) {
    language = next;
    const en = next === 'en';
    root.lang = next; root.dir = en ? 'ltr' : 'rtl';
    body.classList.toggle('english', en);
    $$('[data-fa][data-en]').forEach(el => { const v = el.getAttribute(en ? 'data-en' : 'data-fa'); if (v != null) el.innerHTML = v; });
    splitWords($('.hero h1 span'));
    langText.textContent = en ? 'FA' : 'EN';
    langBtn.setAttribute('aria-label', UI[next].lang);
    $('#theme').setAttribute('aria-label', UI[next].theme);
    $('#sheetClose').setAttribute('aria-label', UI[next].close);
    renderIsland(); if (currentProject) fillSheet(currentProject);
    try { localStorage.setItem('sheymon-language', next); } catch (_) {}
    requestAnimationFrame(placeIndicator);
  }

  /* ---------- Theme ---------- */
  const themeMeta = $('meta[name="theme-color"]');
  function setTheme(t, save) {
    root.setAttribute('data-theme', t);
    if (themeMeta) themeMeta.setAttribute('content', t === 'dark' ? '#110D09' : '#FBF8F3');
    if (save) { try { localStorage.setItem('sheymon-theme', t); } catch (_) {} }
  }
  $('#theme').addEventListener('click', () => setTheme(root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark', true));
  try { matchMedia('(prefers-color-scheme: dark)').addEventListener('change', e => { if (!localStorage.getItem('sheymon-theme')) setTheme(e.matches ? 'dark' : 'light', false); }); } catch (_) {}

  /* ---------- Sliding indicator in the header nav ---------- */
  const nav = $('#nav'); let ind = null;
  if (nav) { ind = document.createElement('i'); ind.className = 'nav-ind'; nav.prepend(ind); }
  function placeIndicator() {
    if (!ind) return;
    const a = $('.nav-link.active', nav) || $('.nav-link', nav);
    ind.style.setProperty('--x', a.offsetLeft + 'px'); ind.style.setProperty('--w', a.offsetWidth + 'px');
  }

  /* ---------- Bottom sheet ---------- */
  const sheet = $('#sheet'), backdrop = $('#sheetBackdrop'), closeBtn = $('#sheetClose'), scroller = $('#sheetScroll');
  let currentProject = null, lastFocus = null;
  const iconStyle = { trade: 'var(--i-appicon)', stellar: 'var(--i-sticon)' };
  function fillSheet(id) {
    const d = P[id], t = d[language], game = id === 'stellar';
    const [fa, en] = d.names;
    const ic = $('#sheetIcon');
    if (id === 'tarazino') { ic.className = 'app-ic sq sq-4'; ic.style.removeProperty('--ic'); ic.innerHTML = '<svg class="ic" aria-hidden="true"><use href="#i-db"/></svg>'; }
    else { ic.className = 'app-ic'; ic.innerHTML = ''; ic.style.setProperty('--ic', iconStyle[id]); }
    const vis = $('#sheetVisual'); vis.innerHTML = `<div data-tpl="cover-${id}" role="img" aria-label="${en}"></div>`; mount(vis);
    $('#sheetType').textContent = t.type;
    $('#sheetTitle').innerHTML = language === 'fa'
      ? `<span class="n1">${fa}</span><span class="n2" dir="auto">${en}</span>`
      : `<span class="n1">${en}</span><span class="n2">${fa}</span>`;
    $('#sheetTagline').textContent = t.tagline;
    $('#sheetText').textContent = t.text;
    $('#subInside').textContent = game ? UI[language].insideGame : UI[language].inside;
    $('#subShots').textContent = game ? UI[language].shotsGame : UI[language].shots;
    $('#subDetails').textContent = UI[language].details;
    $('#sheetFeatures').innerHTML = t.features.map(([i, title, desc], k) =>
      `<li style="--k:${k}"><span class="sq sq-${[1, 2, 4, 3][k % 4]}"><svg class="ic" aria-hidden="true"><use href="#${i}"/></svg></span><span class="li-text"><b>${title}</b><small>${desc}</small></span></li>`).join('');
    const wrap = $('#galleryWrap'); wrap.hidden = !d.gallery.length;
    $('#sheetGallery').innerHTML = d.gallery.map((g, i) => {
      const cap = `<figcaption>${t.shots[i] || ''}</figcaption>`;
      return d.galleryKind === 'win'
        ? `<figure class="shot win"><div class="tscale" data-tpl="${g}" style="aspect-ratio:${g === 't-hist' ? '1000/640' : '1500/840'}" role="img" aria-label="${t.shots[i] || ''}"></div>${cap}</figure>`
        : `<figure class="shot phone"><div class="phone-wrap" role="img" aria-label="${t.shots[i] || ''}"><div class="phone" style="--shot:var(--i-g${g})"><div class="screen"></div></div></div>${cap}</figure>`;
    }).join('');
    mount($('#sheetGallery'));
    $('#sheetKV').innerHTML = t.kv.map(([k, v]) => `<div><dt>${k}</dt><dd dir="auto">${v}</dd></div>`).join('');
    $('#sheetTags').innerHTML = t.tags.map(x => `<span class="tag">${x}</span>`).join('');
  }
  function openSheet(id) {
    lastFocus = document.activeElement; currentProject = id;
    fillSheet(id); scroller.scrollTop = 0;
    sheet.style.transform = ''; backdrop.style.opacity = '';
    body.classList.add('sheet-open');
    sheet.setAttribute('aria-hidden', 'false'); backdrop.setAttribute('aria-hidden', 'false');
    setTimeout(() => closeBtn.focus({ preventScroll: true }), 80);
  }
  function closeSheet() {
    if (!body.classList.contains('sheet-open')) return;
    sheet.style.transform = ''; backdrop.style.opacity = '';
    body.classList.remove('sheet-open'); currentProject = null;
    sheet.setAttribute('aria-hidden', 'true'); backdrop.setAttribute('aria-hidden', 'true');
    if (lastFocus) lastFocus.focus({ preventScroll: true });
  }
  $$('.project').forEach(card => {
    const id = card.dataset.project;
    card.addEventListener('click', () => openSheet(id));
    card.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openSheet(id); } });
  });
  closeBtn.addEventListener('click', closeSheet); backdrop.addEventListener('click', closeSheet);
  $('.grabber').addEventListener('click', closeSheet);
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeSheet(); });
  let startY = 0, dy = 0, dragging = false, tracking = false;
  sheet.addEventListener('touchstart', e => { tracking = scroller.scrollTop <= 0; dragging = false; dy = 0; startY = e.touches[0].clientY; }, { passive: true });
  sheet.addEventListener('touchmove', e => {
    if (!tracking) return; dy = e.touches[0].clientY - startY;
    if (dy > 8 && scroller.scrollTop <= 0) { dragging = true; e.preventDefault(); sheet.style.transition = 'none'; sheet.style.transform = `translateY(${dy}px)`; backdrop.style.opacity = String(Math.max(0, 1 - dy / 420)); }
  }, { passive: false });
  sheet.addEventListener('touchend', () => {
    if (!dragging) return; sheet.style.transition = ''; void sheet.offsetHeight;
    if (dy > 120) closeSheet(); else { sheet.style.transform = ''; backdrop.style.opacity = ''; }
    dragging = false; tracking = false;
  });

  /* ---------- Dynamic-Island project switcher ---------- */
  const island = $('#island'), order = ['trade', 'stellar', 'tarazino'];
  let islandIdx = 0, islandOpen = false;
  function renderIsland() {
    const id = order[islandIdx], t = P[id][language];
    $('#islandName').textContent = P[id].names[language === 'fa' ? 0 : 1]; $('#islandKind').textContent = t.kind;
    $('#islandUse').setAttribute('href', '#' + P[id].icon);
    island.setAttribute('aria-label', UI[language].open + ': ' + P[id].names[language === 'fa' ? 0 : 1]);
  }
  function islandStep() {
    if (document.hidden || body.classList.contains('sheet-open')) return;
    if (islandOpen) { island.classList.remove('open'); islandOpen = false; islandIdx = (islandIdx + 1) % order.length; }
    else { renderIsland(); island.classList.add('open'); islandOpen = true; }
  }
  island.addEventListener('click', () => openSheet(order[islandIdx]));
  renderIsland();
  if (!reduced) { setTimeout(islandStep, 1600); setInterval(islandStep, 3400); } else island.classList.add('open');

  /* ---------- Scroll polish: header, minimising tab bar, hero depth ---------- */
  const header = $('.site-header'), tabbar = $('#tabbar'), heroArt = $('#heroArt');
  let lastY = scrollY, ticking = false;
  function onScroll() {
    if (ticking) return; ticking = true;
    requestAnimationFrame(() => {
      const y = scrollY;
      header.classList.toggle('scrolled', y > 8);
      if (tabbar) { if (y > lastY + 6 && y > 140) tabbar.classList.add('min'); else if (y < lastY - 6 || y < 80) tabbar.classList.remove('min'); }
      if (!reduced && heroArt && y < 900) heroArt.style.setProperty('--sy', y.toFixed(0));
      lastY = y; ticking = false;
    });
  }
  addEventListener('scroll', onScroll, { passive: true });
  tabbar && tabbar.addEventListener('click', () => tabbar.classList.remove('min'));

  /* ---------- Pointer effects (desktop only): hero depth + card tilt/glare ---------- */
  if (finePointer && !reduced) {
    const hero = $('.hero');
    hero.addEventListener('pointermove', e => {
      const r = heroArt.getBoundingClientRect();
      heroArt.style.setProperty('--mx', (((e.clientX - r.left) / r.width) * 2 - 1).toFixed(3));
      heroArt.style.setProperty('--my', (((e.clientY - r.top) / r.height) * 2 - 1).toFixed(3));
    });
    hero.addEventListener('pointerleave', () => { heroArt.style.setProperty('--mx', 0); heroArt.style.setProperty('--my', 0); });
    $$('.project').forEach(card => {
      let raf = 0;
      card.addEventListener('pointermove', e => {
        if (raf) return;
        raf = requestAnimationFrame(() => {
          raf = 0; const r = card.getBoundingClientRect(), x = (e.clientX - r.left) / r.width, y = (e.clientY - r.top) / r.height;
          card.style.transition = 'transform .12s linear, box-shadow .35s ease';
          card.style.transform = `perspective(1000px) rotateX(${((.5 - y) * 5).toFixed(2)}deg) rotateY(${((x - .5) * 6).toFixed(2)}deg) translateY(-6px)`;
          card.style.setProperty('--gx', (x * 100).toFixed(1) + '%'); card.style.setProperty('--gy', (y * 100).toFixed(1) + '%');
        });
      });
      card.addEventListener('pointerleave', () => { card.style.transition = ''; card.style.transform = ''; });
    });
  }

  /* ---------- Reveal on scroll ---------- */
  if ('IntersectionObserver' in window && !reduced) {
    const io = new IntersectionObserver(es => es.forEach(en => { if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); if (en.target.classList.contains('about-card')) countUp(); } }), { threshold: .12, rootMargin: '0px 0px -6% 0px' });
    $$('.section-head, .project, .projects-end, .about-card, .tool, .contact-art, .list-card').forEach(el => {
      if (el.getBoundingClientRect().top < innerHeight * .9) return;
      el.classList.add('reveal');
      const k = el.classList.contains('tool') ? $$('.tool').indexOf(el) % 4 : (el.classList.contains('project') ? $$('.project').indexOf(el) : 0);
      el.style.setProperty('--d', (k * .08).toFixed(2) + 's'); io.observe(el);
    });
  }
  function countUp() {
    const n = $('.w-a b'); if (!n || n.dataset.done) return; n.dataset.done = 1;
    const to = +n.textContent || 3; let v = 0; n.textContent = '0';
    const step = () => { v += 1; n.textContent = v; if (v < to) setTimeout(step, 260); }; setTimeout(step, 300);
  }

  /* ---------- Active section ---------- */
  if ('IntersectionObserver' in window) {
    const links = $$('.nav-link');
    const io2 = new IntersectionObserver(es => es.forEach(en => {
      if (!en.isIntersecting) return; const h = '#' + (en.target.id === 'toolkit' ? 'about' : en.target.id);
      links.forEach(l => l.classList.toggle('active', l.hash === h)); placeIndicator();
    }), { rootMargin: '-40% 0px -55% 0px' });
    ['home', 'projects', 'about', 'toolkit', 'contact'].forEach(id => { const el = document.getElementById(id); if (el) io2.observe(el); });
  }

  langBtn.addEventListener('click', () => setLanguage(language === 'fa' ? 'en' : 'fa'));
  try { setLanguage(localStorage.getItem('sheymon-language') === 'en' ? 'en' : 'fa'); } catch (_) { setLanguage('fa'); }
  addEventListener('resize', placeIndicator); placeIndicator();
})();

/* SHEYMON — v13 · Liquid Glass inspired
   One self-contained design: light/dark, spring motion, glass only on a few small fixed layers. */
:root{
  --font: Vazirmatn, -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", system-ui, sans-serif;
  --font-en: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Segoe UI", Inter, system-ui, Vazirmatn, sans-serif;
  --bg:#FCF8F2; --bg-2:#F6EBDC; --surface:#FFFFFF; --surface-2:#FBF3E8;
  --text:#201912; --text-2:#6B5D50; --text-3:#9A8B7D;
  --line:rgba(70,45,20,.10);
  --accent:#A8651F; --accent-strong:#8A4F14; --on-accent:#FFFFFF; --accent-soft:rgba(198,134,66,.16); --caramel:#C68642;
  --glass:rgba(255,252,247,.58); --glass-line:rgba(255,255,255,.75);
  --rim-a:rgba(255,255,255,.95); --rim-b:rgba(255,255,255,.14); --rim-c:rgba(255,255,255,.7);
  --card-bg:linear-gradient(180deg,rgba(255,255,255,.90),rgba(255,251,245,.70));
  --card-line:rgba(255,255,255,.85); --card-hi:inset 0 1px 0 rgba(255,255,255,.95);
  --b1:rgba(247,170,104,.58); --b2:rgba(243,160,150,.42); --b3:rgba(240,206,128,.55);
  --shadow:0 1px 2px rgba(70,45,20,.05), 0 16px 38px -16px rgba(120,70,20,.26);
  --shadow-s:0 1px 1px rgba(70,45,20,.05), 0 8px 24px -10px rgba(70,45,20,.22);
  --radius:30px;
  --ease:cubic-bezier(.32,.72,0,1); --spring:cubic-bezier(.34,1.45,.5,1); --out:cubic-bezier(.22,1,.36,1);
  --tab-h:68px; color-scheme:light;
}
:root[data-theme="dark"]{
  --bg:#120D09; --bg-2:#18110C; --surface:#1B150F; --surface-2:#251C14;
  --text:#F6EFE7; --text-2:#BBAC9D; --text-3:#8B7C6D;
  --line:rgba(255,236,214,.09);
  --accent:#DDA364; --accent-strong:#F0C089; --on-accent:#21150A; --accent-soft:rgba(221,163,100,.16); --caramel:#DDA364;
  --glass:rgba(32,25,18,.56); --glass-line:rgba(255,236,214,.10);
  --rim-a:rgba(255,236,214,.38); --rim-b:rgba(255,236,214,.05); --rim-c:rgba(255,236,214,.24);
  --card-bg:linear-gradient(180deg,rgba(40,31,23,.82),rgba(28,21,15,.68));
  --card-line:rgba(255,236,214,.10); --card-hi:inset 0 1px 0 rgba(255,236,214,.08);
  --b1:rgba(205,120,48,.34); --b2:rgba(160,72,62,.30); --b3:rgba(196,152,70,.20);
  --shadow:0 1px 2px rgba(0,0,0,.4), 0 18px 40px -16px rgba(0,0,0,.7);
  --shadow-s:0 1px 1px rgba(0,0,0,.4), 0 10px 26px -10px rgba(0,0,0,.7);
  color-scheme:dark;
}
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:92px;-webkit-text-size-adjust:100%;text-size-adjust:100%}
body{margin:0;min-height:100vh;background:var(--bg);color:var(--text);font:400 16px/1.8 var(--font);-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;overflow-x:hidden;-webkit-tap-highlight-color:transparent;transition:background-color .4s ease,color .4s ease}
body.english{font-family:var(--font-en);line-height:1.65}
body.english h1,body.english h2,body.english h3{letter-spacing:-.025em}
img{display:block;max-width:100%;height:auto}
a{color:inherit;text-decoration:none}
button{font:inherit;color:inherit;cursor:pointer;border:0;background:none}
h1,h2,h3,h4,p,ul,figure,dl,dd{margin:0}
ul{padding:0;list-style:none}
:focus-visible{outline:3px solid var(--caramel);outline-offset:3px;border-radius:12px}
.ic{width:22px;height:22px;flex:none;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
[dir="rtl"] .chev{transform:scaleX(-1)}
.container{width:min(1120px,calc(100% - 40px));margin-inline:auto}
.skip{position:fixed;inset-inline-start:12px;top:-60px;z-index:100;background:var(--accent);color:var(--on-accent);padding:10px 16px;border-radius:12px}
.skip:focus{top:12px}

/* Brand mark: one PNG used as a mask, so it follows the text colour in both themes */
.logo,.about-logo,.chat-logo{display:block;background:currentColor;-webkit-mask:var(--i-logo) center/contain no-repeat;mask:var(--i-logo) center/contain no-repeat;aspect-ratio:284/420}
.logo{height:36px;color:var(--text)}

/* Liquid-glass rim (specular edge) */
.rim{position:relative}
.rim::before,.card::before{content:"";position:absolute;inset:0;border-radius:inherit;padding:1px;pointer-events:none;z-index:1;
  background:linear-gradient(140deg,var(--rim-a),var(--rim-b) 38%,var(--rim-b) 62%,var(--rim-c));
  -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask:linear-gradient(#000 0 0) content-box exclude,linear-gradient(#000 0 0)}

/* ---------- Living background ---------- */
.bg{position:fixed;inset:0;z-index:-1;overflow:hidden;pointer-events:none;background:radial-gradient(90% 60% at 50% 0%,rgba(255,255,255,.55),transparent 70%),linear-gradient(180deg,var(--bg),var(--bg-2))}
:root[data-theme="dark"] .bg{background:radial-gradient(90% 60% at 50% 0%,rgba(255,214,170,.05),transparent 70%),linear-gradient(180deg,var(--bg),var(--bg-2))}
.blob{position:absolute;border-radius:50%;will-change:transform;contain:strict}
.b1{width:92vmax;height:92vmax;top:-46vmax;right:-34vmax;background:radial-gradient(circle,var(--b1),transparent 66%);animation:drift1 34s ease-in-out infinite alternate}
.b2{width:84vmax;height:84vmax;bottom:-44vmax;left:-34vmax;background:radial-gradient(circle,var(--b2),transparent 66%);animation:drift2 40s ease-in-out infinite alternate}
.b3{width:70vmax;height:70vmax;top:28vh;left:8vw;background:radial-gradient(circle,var(--b3),transparent 66%);animation:drift3 46s ease-in-out infinite alternate}
@keyframes drift1{to{transform:translate3d(-14vmax,10vmax,0) scale(1.08)}}
@keyframes drift2{to{transform:translate3d(16vmax,-8vmax,0) scale(1.1)}}
@keyframes drift3{to{transform:translate3d(18vmax,12vmax,0) scale(.92)}}

/* ---------- Header (always left-to-right, never moves between languages) ---------- */
.site-header{position:fixed;top:max(10px,env(safe-area-inset-top));left:0;right:0;margin-inline:auto;z-index:50;width:min(1120px,calc(100% - 24px));height:62px;padding-inline:16px 10px;display:flex;align-items:center;justify-content:space-between;gap:12px;direction:ltr;
  background:var(--glass);border-radius:26px;-webkit-backdrop-filter:saturate(200%) blur(24px);backdrop-filter:saturate(200%) blur(24px);box-shadow:var(--shadow-s);transition:box-shadow .3s ease,transform .5s var(--spring)}
.site-header.scrolled{box-shadow:var(--shadow)}
.brand{display:flex;align-items:center;gap:11px;height:100%;direction:ltr}
.brand-name{font:800 1.02rem/1 var(--font-en);letter-spacing:.2em;color:var(--text)}
.footer .logo{height:32px}
.footer-brand{display:inline-flex;align-items:center;gap:10px;direction:ltr}
.footer .brand-name{font-size:.9rem}
.main-nav{position:relative;display:flex;gap:2px;padding:4px;border-radius:999px;background:var(--accent-soft);direction:ltr}
.nav-ind{position:absolute;top:4px;bottom:4px;left:0;width:var(--w,92px);transform:translateX(var(--x,4px));border-radius:999px;background:var(--surface);box-shadow:0 1px 3px rgba(70,45,20,.14),inset 0 1px 0 rgba(255,255,255,.7);transition:transform .6s var(--spring),width .6s var(--spring)}
:root[data-theme="dark"] .nav-ind{background:var(--surface-2)}
.nav-link{position:relative;z-index:1;width:92px;padding:7px 8px;text-align:center;white-space:nowrap;border-radius:999px;font-size:.92rem;font-weight:500;color:var(--text-2);transition:color .3s ease}
.main-nav .nav-link:hover{color:var(--text)}
.main-nav .nav-link.active{color:var(--text)}
.header-actions{display:flex;align-items:center;gap:8px;direction:ltr}
.icon-btn{height:42px;min-width:42px;padding-inline:12px;border-radius:999px;display:inline-flex;align-items:center;justify-content:center;gap:6px;background:var(--accent-soft);color:var(--text);font-size:.82rem;font-weight:700;letter-spacing:.04em;transition:transform .3s var(--spring),background .25s ease}
.lang-btn{min-width:48px}
.icon-btn:active{transform:scale(.86)}
.theme-btn .ic{transition:transform .6s var(--spring)}
.theme-btn:active .ic{transform:rotate(30deg) scale(.88)}
.theme-btn .ic-moon{display:none}
:root[data-theme="dark"] .theme-btn .ic-sun{display:none}
:root[data-theme="dark"] .theme-btn .ic-moon{display:block}
.header-cta{width:150px;padding-inline:8px;white-space:nowrap}

/* ---------- Buttons / tags ---------- */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;height:52px;padding-inline:26px;border-radius:999px;font-weight:600;font-size:1rem;transition:transform .4s var(--spring),filter .2s ease,box-shadow .3s ease}
.btn:active{transform:scale(.93)}
.btn-primary{background:linear-gradient(180deg,color-mix(in srgb,var(--accent) 86%,#fff),var(--accent));color:var(--on-accent);box-shadow:0 12px 24px -12px var(--accent),inset 0 1px 0 rgba(255,255,255,.3)}
.btn-primary:hover{filter:brightness(1.07)}
.btn-primary .ic{transition:transform .45s var(--spring)}
.btn-primary:hover .ic{transform:translate(2px,-2px)}
.btn-soft{background:var(--glass);color:var(--accent-strong);box-shadow:var(--shadow-s)}
.btn-sm{height:42px;padding-inline:20px;font-size:.9rem;box-shadow:none}
.tag{display:inline-flex;align-items:center;padding:3px 12px;border-radius:999px;font-size:.78rem;font-weight:600;color:var(--text-2);background:var(--surface-2);border:1px solid var(--line)}
.tag-accent{background:var(--accent-soft);border-color:transparent;color:var(--accent-strong)}
.tags{display:flex;flex-wrap:wrap;gap:6px}
.dot{width:8px;height:8px;border-radius:50%;background:var(--caramel);display:inline-block;flex:none}
.pill{display:inline-flex;align-items:center;gap:10px;padding:7px 16px;border-radius:999px;background:var(--glass);box-shadow:var(--shadow-s);font-size:.9rem;font-weight:500;color:var(--text-2)}
.pill .dot{animation:pulse 2.4s ease-in-out infinite}
@keyframes pulse{50%{transform:scale(.6);opacity:.5}}
.sq{width:46px;height:46px;border-radius:14px;display:grid;place-items:center;flex:none;color:#fff;background:linear-gradient(160deg,#E4AA6C,#B8742E);box-shadow:inset 0 1px 0 rgba(255,255,255,.4),0 6px 14px -8px rgba(138,79,20,.6)}
.sq-2{background:linear-gradient(160deg,#EFC793,#C98B4A)}.sq-3{background:linear-gradient(160deg,#6E4E35,#3A2818)}.sq-4{background:linear-gradient(160deg,#D89F60,#9A5B1A)}

/* iOS material card */
.card{position:relative;background:var(--card-bg);border:1px solid var(--card-line);border-radius:var(--radius);box-shadow:var(--shadow),var(--card-hi);transition:background-color .4s ease,border-color .4s ease}
.card::before{opacity:.55}
@media (min-width:821px){.glass{-webkit-backdrop-filter:blur(18px) saturate(170%);backdrop-filter:blur(18px) saturate(170%)}}

/* ---------- Sections ---------- */
.section{padding-block:clamp(56px,9vw,112px)}
.section-head{max-width:640px;margin-bottom:clamp(28px,4vw,48px);display:grid;gap:12px}
h2{font-size:clamp(1.9rem,4.6vw,3rem);line-height:1.25;font-weight:800}
.section-head p{color:var(--text-2);font-size:1.05rem}

/* ---------- Hero ---------- */
.hero{padding-top:clamp(112px,14vw,150px);padding-bottom:clamp(40px,7vw,80px);display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(28px,5vw,72px);align-items:center}
.hero-copy{display:grid;gap:24px;justify-items:start}
h1{font-size:clamp(2.3rem,6.2vw,4.4rem);line-height:1.22;font-weight:800;max-width:15ch}
body.english h1{line-height:1.06;max-width:12ch}
.w{display:inline-block;opacity:0;transform:translateY(.55em);animation:wordIn .9s var(--out) forwards;animation-delay:calc(var(--i) * 70ms + 120ms)}
@keyframes wordIn{to{opacity:1;transform:none}}
.lead{color:var(--text-2);font-size:clamp(1rem,1.5vw,1.14rem);max-width:48ch}
.hero-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:6px}
.hero-art{position:relative;justify-self:center;width:100%;max-width:470px;aspect-ratio:960/1100;container-type:inline-size}
.hero-stage{position:absolute;inset:0;border-radius:38px;overflow:hidden;box-shadow:var(--shadow),0 0 0 1px var(--card-line);
  background:radial-gradient(70% 45% at 85% 0%,rgba(255,255,255,.7),transparent 70%),radial-gradient(60% 40% at 0% 100%,rgba(120,60,15,.35),transparent 70%),linear-gradient(155deg,#F8DDB8,#E2AB6D 55%,#B8742E)}
.hl{position:absolute;transform:translate3d(calc(var(--mx,0) * var(--d) * 16px),calc(var(--my,0) * var(--d) * 12px + var(--sy,0) * var(--d) * -.04px),0) rotate(var(--rot,0deg));transition:transform .6s var(--out);will-change:transform}
.hl-win{left:-8%;top:13.5%;width:92%}
.hl-phone-r{left:57.5%;top:47%;width:37%}
.hl-phone-l{left:6%;top:57%;width:28%}
.hl-win .tscale{border-radius:3.4cqw;box-shadow:0 4cqw 9cqw -2cqw rgba(0,0,0,.55)}
.chip{position:absolute;display:flex;align-items:center;gap:12px;border-radius:999px;direction:ltr;background:var(--glass);box-shadow:var(--shadow-s);font-size:.9rem;white-space:nowrap;-webkit-backdrop-filter:saturate(190%) blur(18px);backdrop-filter:saturate(190%) blur(18px);padding:10px 18px 10px 12px;z-index:3}
.chip::before{content:"";position:absolute;inset:0;border-radius:inherit;padding:1px;pointer-events:none;background:linear-gradient(140deg,var(--rim-a),var(--rim-b) 40%,var(--rim-c));-webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask:linear-gradient(#000 0 0) content-box exclude,linear-gradient(#000 0 0)}
.chip-ic{width:34px;height:34px;border-radius:11px;display:grid;place-items:center;color:#fff;background:linear-gradient(160deg,#E4AA6C,#B8742E)}
.chip-ic .ic{width:18px;height:18px}
.chip-a{top:22.5%;left:-6%;animation:bob 7s ease-in-out infinite alternate}
.chip-b{bottom:9%;right:-6%;animation:bob 8s ease-in-out -3s infinite alternate}
@keyframes bob{to{transform:translateY(-8px)}}
.island{position:absolute;top:3.4%;left:50%;z-index:4;width:112px;height:36px;border-radius:20px;padding:0;overflow:hidden;background:#0B0705;color:#fff;translate:-50% 0;box-shadow:0 12px 26px -8px rgba(0,0,0,.55);transition:width .75s var(--spring),height .75s var(--spring),border-radius .75s var(--spring),transform .3s var(--spring)}
.island:active{transform:scale(.96)}
.island.open{width:min(300px,92%);height:62px;border-radius:31px}
.island-idle{position:absolute;inset:0;display:flex;align-items:center;justify-content:flex-end;padding-right:14px;transition:opacity .25s ease}
.idle-dot{width:9px;height:9px;border-radius:50%;background:var(--caramel);box-shadow:0 0 0 4px rgba(198,134,66,.22);animation:pulse 2.4s ease-in-out infinite}
.island.open .island-idle{opacity:0}
.island-body{position:absolute;inset:0;display:flex;align-items:center;gap:12px;padding:0 12px;opacity:0;text-align:start;transition:opacity .2s ease}
.island.open .island-body{opacity:1;transition:opacity .35s ease .22s}
.island-ic{width:38px;height:38px;border-radius:12px}.island-ic .ic{width:19px;height:19px}
.island-text{display:grid;min-width:0;line-height:1.35}
.island-text b{font-size:.92rem;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.island-text small{font-size:.76rem;color:rgba(255,255,255,.62);white-space:nowrap}
@keyframes rise{from{opacity:0;transform:translateY(18px) scale(.985)}to{opacity:1;transform:none}}
.hero-copy>:not(h1){animation:rise .9s var(--out) both}
.hero-copy>:nth-child(1){animation-delay:.02s}.hero-copy>:nth-child(3){animation-delay:.34s}.hero-copy>:nth-child(4){animation-delay:.44s}
.hero-stage{animation:rise 1.1s var(--out) .12s both}
.js .reveal{opacity:0;transform:translateY(34px) scale(.975);transition:opacity .8s var(--out),transform 1s var(--out);transition-delay:var(--d,0s)}
.js .reveal.in{opacity:1;transform:none}

/* ---------- Phone frame + live app windows ---------- */
.phone-wrap{container-type:inline-size;width:100%}
.phone{position:relative;border-radius:15cqw;padding:2.8cqw;background:#0e0c0c;box-shadow:inset 0 0 0 .7cqw #4d4743,0 4cqw 9cqw -2cqw rgba(0,0,0,.55)}
.phone::before{content:"";position:absolute;z-index:2;top:5.6cqw;left:50%;width:27cqw;height:7.2cqw;border-radius:99px;background:#050505;transform:translateX(-50%)}
.phone .screen{aspect-ratio:540/1170;border-radius:12.3cqw;background:var(--shot) center/cover no-repeat}

.tscale{position:relative;overflow:hidden;background:#080B12}
.tscale>.tapp{position:absolute;left:0;top:0;transform-origin:0 0;transform:scale(var(--s,.5))}
.t-main{width:1500px;height:840px}.t-hist{width:1000px;height:640px}
.tapp{font-family:var(--font);color:#F0F6FC;direction:ltr;text-align:left;line-height:1.4;overflow:hidden;background:#080B12;-webkit-font-smoothing:antialiased}
.tapp *{box-sizing:border-box;margin:0}
.tapp b{font-weight:700}
.t-bg{position:absolute;inset:0;background:var(--i-tbg) center/cover no-repeat;transform:scale(1.05)}
.t-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(7,11,18,.45),rgba(7,11,18,.28))}
.t-win{position:absolute;inset:0;padding:16px 18px;display:flex;flex-direction:column;gap:12px}
.t-card{background:linear-gradient(180deg,rgba(21,28,41,.42),rgba(21,28,41,.66));border:1px solid rgba(255,255,255,.22);border-radius:16px;box-shadow:0 10px 30px -10px rgba(0,0,0,.6),inset 0 1px 0 rgba(255,255,255,.14)}
.t-top{display:flex;align-items:center;gap:18px;padding:0 4px}
.t-icon{width:42px;height:42px;border-radius:11px;background:var(--i-appicon) center/cover}
.t-ttl{direction:rtl;text-align:right}.t-ttl b{font-size:22px;display:block;line-height:1.3}.t-ttl small{font-size:13px;color:#9BA7B8;direction:ltr;display:block;text-align:left;font-family:var(--font-en)}
.t-marq{flex:1;height:34px;border-radius:17px;background:rgba(21,28,41,.45);border:1px solid rgba(255,255,255,.14);overflow:hidden;font-size:12.5px;color:#C9D4E3;white-space:nowrap;line-height:34px;direction:rtl;text-align:right;padding:0 16px}
.t-badge{background:rgba(35,134,54,.5);border:1px solid rgba(56,255,122,.35);color:#38FF7A;border-radius:12px;padding:5px 12px;font-size:12px;font-weight:700;display:flex;gap:7px;align-items:center;direction:rtl}
.t-badge i{width:8px;height:8px;border-radius:50%;background:#38FF7A;box-shadow:0 0 10px #38FF7A}
.t-controls{display:flex;gap:10px;align-items:center}
.t-pricebox{display:flex;align-items:center;gap:10px;padding:0 16px;height:46px;direction:rtl}
.t-pricebox small{font-size:11px;color:#9BA7B8}.t-pricebox b{font-size:19px;direction:ltr;font-family:var(--font-en);font-variant-numeric:tabular-nums}
.t-inp{height:46px;border-radius:12px;display:flex;align-items:center;padding:0 14px;font-size:16px;font-weight:700;font-family:var(--font-en)}
.t-sym{width:130px;letter-spacing:.06em}.t-tf{width:150px;justify-content:space-between;font-size:13px;direction:rtl;font-weight:600;font-family:var(--font)}.t-tf span{color:#AAB4C4;font-size:11px}
.t-btn{height:46px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:13.5px;border:1px solid rgba(255,255,255,.33);padding:0 20px;background:rgba(31,111,235,.4);box-shadow:0 0 18px rgba(31,111,235,.35)}
.t-btn.t-p{background:rgba(110,64,201,.42);box-shadow:0 0 18px rgba(110,64,201,.35)}.t-btn.t-o{background:rgba(240,136,62,.4);box-shadow:0 0 18px rgba(240,136,62,.3)}.t-btn.t-g{background:rgba(85,96,120,.38);box-shadow:none}
.t-mainrow{flex:1;display:flex;gap:12px;min-height:0}
.t-tbl{width:340px;padding:12px;display:flex;flex-direction:column;gap:6px;flex:none}
.t-th,.t-tr{display:grid;grid-template-columns:1.1fr 1fr 1fr 1fr 1fr;text-align:center}
.t-th{padding:5px 4px;border-radius:10px;background:rgba(21,28,41,.35)}
.t-th b{display:block;font-size:11px;color:#9BA7B8;direction:rtl}.t-th small{font-size:8.5px;color:#6B7686;font-family:var(--font-en)}
.t-tr{font-size:11px;padding:6px 4px;border-bottom:1px solid rgba(255,255,255,.06);font-family:var(--font-en);font-variant-numeric:tabular-nums}
.t-right{flex:1;display:flex;flex-direction:column;gap:12px;min-width:0}
.t-chartc{padding:12px 14px;height:366px;position:relative;overflow:hidden}.t-chartc svg{width:100%;height:auto;display:block}
.t-chartc svg text{font-family:var(--font-en)}
.t-tgl{position:absolute;top:12px;right:16px;display:flex;gap:8px;direction:rtl}.t-tgl span{font-size:11px;padding:3px 10px;border-radius:9px;border:1px solid rgba(255,255,255,.2);color:#C9D4E3;background:rgba(21,28,41,.4)}
.t-tgl span.t-on{background:rgba(110,64,201,.5);border-color:rgba(179,146,240,.6);color:#fff}
.t-cinfo span{unicode-bidi:plaintext}.t-cinfo{font-size:12px;color:#9BA7B8;margin-bottom:4px;display:flex;gap:14px}.t-cinfo b{color:#F0F6FC;font-family:var(--font-en)}
.t-grid3{display:grid;grid-template-columns:1fr 1.25fr 1fr;gap:12px;flex:1;min-height:0;direction:rtl}
.t-pc{padding:14px 16px;display:flex;flex-direction:column;gap:9px;font-size:12.5px;text-align:right}
.t-pc h4{font-size:14px;display:flex;align-items:center;gap:8px;font-weight:700}.t-pc h4 i{width:9px;height:9px;border-radius:50%}
.t-big{font-size:20px;font-weight:700;line-height:1.5}
.t-row{display:flex;justify-content:space-between;color:#C9D4E3}.t-row b{color:#F0F6FC;direction:ltr;font-family:var(--font-en);font-variant-numeric:tabular-nums}
.t-bar{height:8px;border-radius:5px;background:rgba(255,255,255,.12);overflow:hidden;direction:ltr}.t-bar i{display:block;height:100%;border-radius:5px}
.t-ins{display:flex;gap:8px;align-items:flex-start;color:#D6DEE8;line-height:1.7}.t-ins:before{content:"";flex:none;margin-top:9px;width:6px;height:6px;border-radius:50%;background:var(--c,#4BFFA3)}
.t-status{height:26px;display:flex;justify-content:space-between;align-items:center;font-size:11.5px;color:#9BA7B8;padding:0 8px;direction:rtl}.t-status b{color:#4BFFA3;font-weight:600}
.t-hw{position:absolute;inset:0;padding:22px 26px;display:flex;flex-direction:column;gap:14px}.t-hw h1{font-size:26px;font-weight:700;direction:rtl;text-align:right}
.t-ht,.t-hr{display:grid;grid-template-columns:110px 210px 130px 140px 120px 1fr;text-align:left}
.t-ht{padding:10px 16px;font-size:12px;color:#9BA7B8;font-weight:700;border-bottom:1px solid rgba(255,255,255,.2)}
.t-hr{align-items:center;padding:11px 16px;font-size:13px;border-bottom:1px solid rgba(255,255,255,.07);font-family:var(--font);font-variant-numeric:tabular-nums}
.t-hr:nth-child(even){background:rgba(255,255,255,.035)}
.t-sm{height:28px;border-radius:9px;display:inline-flex;align-items:center;padding:0 12px;font-size:11.5px;font-weight:700;border:1px solid rgba(255,255,255,.25)}
.t-foot{display:flex;justify-content:space-between;margin-top:auto;direction:rtl}

/* ---------- Project covers (built live) ---------- */
.cover{position:relative;overflow:hidden;aspect-ratio:3/2;container-type:inline-size;width:100%}
.cover .tscale{box-shadow:0 2.2cqw 6cqw rgba(0,0,0,.6)}
.cover-trade{background:var(--i-tbg) center/cover}
.cover-trade .c-win{position:absolute;left:7.5%;top:8.7%;width:85%}.cover-trade .c-win .tscale{border-radius:2.4cqw}
.cover-trade .c-hist{position:absolute;right:2.8%;bottom:4.3%;width:50%}.cover-trade .c-hist .tscale{border-radius:2cqw}
