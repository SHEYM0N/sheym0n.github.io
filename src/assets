.cover-tarazino{background:var(--i-taz) center/cover}

/* ---------- Projects ---------- */
.project-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}
.project{overflow:hidden;cursor:pointer;display:flex;flex-direction:column;transform-style:preserve-3d;will-change:transform}
.project.in,.project:not(.reveal){transition:transform .6s var(--spring),box-shadow .35s ease,opacity .8s var(--out)}
.project:active{transform:scale(.975)!important}
.project::after{content:"";position:absolute;inset:0;z-index:2;pointer-events:none;border-radius:inherit;background:radial-gradient(420px circle at var(--gx,50%) var(--gy,50%),rgba(255,255,255,.34),transparent 60%);mix-blend-mode:soft-light;opacity:0;transition:opacity .3s ease}
@media (hover:hover) and (pointer:fine){.project:hover::after{opacity:1}}
.project-wide{grid-column:1/-1;flex-direction:row}
.project-visual{position:relative;overflow:hidden;background:var(--bg-2)}
.project-wide .project-visual{flex:1.25;min-height:300px}
.project-wide .project-visual .cover{position:absolute;inset:0;aspect-ratio:auto;height:100%}
.project-body{padding:clamp(20px,3vw,32px);display:grid;gap:12px;align-content:start;justify-items:start;flex:1}
.project-wide .project-body{flex:1;align-content:center;padding:clamp(24px,4vw,48px)}
h3{font-size:1.45rem;line-height:1.3;font-weight:800}
.pname{display:grid;gap:2px;line-height:1.25}
.pname .n1{font-size:1.5rem;font-weight:800}
.pname .n2{font-size:.9rem;font-weight:600;color:var(--text-3);letter-spacing:.06em;text-align:start}
body.english .pname .n2{letter-spacing:0;font-size:.95rem}
.project-body p{color:var(--text-2);font-size:.98rem}
.project-foot{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px;width:100%;margin-top:auto;padding-top:8px}
.more{display:inline-flex;align-items:center;gap:2px;color:var(--accent-strong);font-weight:600;font-size:.92rem}
.more .ic{width:18px;height:18px;transition:transform .4s var(--spring)}
@media (hover:hover){.project:hover .more .ic{transform:translateX(3px)}[dir="rtl"] .project:hover .more .ic{transform:scaleX(-1) translateX(3px)}}
.projects-end{display:flex;align-items:center;justify-content:center;gap:10px;margin-top:36px;color:var(--text-3);font-size:.95rem}

/* ---------- About ---------- */
.band{background:linear-gradient(180deg,transparent,rgba(198,134,66,.08) 20%,rgba(198,134,66,.08) 80%,transparent)}
.about-card{display:grid;grid-template-columns:.8fr 1.2fr;overflow:hidden;gap:0}
.about-copy{padding:clamp(24px,5vw,56px);display:grid;gap:20px;justify-items:start;align-content:center}
.about-copy p{color:var(--text-2)}
.about-role{color:var(--accent-strong)!important;font-weight:600;font-size:.95rem}
.about-art{position:relative;min-height:100%;overflow:hidden;background:radial-gradient(70% 50% at 20% 10%,rgba(255,255,255,.55),transparent 70%),linear-gradient(160deg,#F6DDB8,#E0A465 55%,#B8742E)}
:root[data-theme="dark"] .about-art{background:radial-gradient(70% 50% at 20% 10%,rgba(255,214,170,.18),transparent 70%),linear-gradient(160deg,#3A2616,#241710 60%,#150E09)}
.about-logo{position:absolute;top:50%;left:50%;height:46%;translate:-50% -58%;color:#2A1D13;opacity:.95}
:root[data-theme="dark"] .about-logo{color:#F6EFE7}
.widget{position:absolute;display:grid;gap:2px;padding:14px 18px;border-radius:24px;background:var(--glass);box-shadow:var(--shadow-s);-webkit-backdrop-filter:blur(16px) saturate(180%);backdrop-filter:blur(16px) saturate(180%);color:var(--text);min-width:140px}
.widget::before{content:"";position:absolute;inset:0;border-radius:inherit;padding:1px;pointer-events:none;background:linear-gradient(140deg,var(--rim-a),var(--rim-b) 40%,var(--rim-c));-webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask:linear-gradient(#000 0 0) content-box exclude,linear-gradient(#000 0 0)}
.widget small{color:var(--text-2);font-size:.78rem;font-weight:600}
.widget b{font-size:1.05rem;font-weight:800;line-height:1.3}
.widget span:not(.sq){font-size:.78rem;color:var(--text-2)}
.w-a b{font-size:2.4rem;line-height:1}
.w-a{top:18px;inset-inline-start:18px}.w-b{bottom:92px;inset-inline-end:18px}
.w-c{bottom:18px;inset-inline-start:18px;display:flex;align-items:center;gap:12px}
.list{width:100%;border-radius:22px;background:var(--surface-2);border:1px solid var(--line);overflow:hidden}
.list li{display:flex;align-items:center;gap:14px;padding:12px 16px}
.list li+li{border-top:1px solid var(--line)}
.list .sq{width:40px;height:40px;border-radius:12px}.list .sq .ic{width:20px;height:20px}
.li-text{display:grid;line-height:1.5}.li-text b{font-weight:700;font-size:.98rem}.li-text small{color:var(--text-2);font-size:.84rem}

/* ---------- Skills ---------- */
.tool-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.tool{padding:22px;display:grid;gap:6px;justify-items:start;align-content:start;transition:transform .5s var(--spring),opacity .8s var(--out)}
.tool:active{transform:scale(.95)!important}
.tool .sq{margin-bottom:10px;width:52px;height:52px;border-radius:16px;transition:transform .5s var(--spring)}
@media (hover:hover){.tool:hover .sq{transform:translateY(-3px) scale(1.06) rotate(-3deg)}}
.tool b{font-size:1.05rem;font-weight:700}
.tool small{color:var(--text-2);font-size:.88rem;line-height:1.6}

/* ---------- Contact ---------- */
.contact-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:20px;align-items:stretch}
.contact-art{position:relative;overflow:hidden;display:flex;flex-direction:column;justify-content:center;gap:12px;padding:28px;direction:ltr;min-height:260px;background:radial-gradient(70% 60% at 85% 0%,rgba(255,255,255,.5),transparent 70%),linear-gradient(160deg,#F8E2C2,#E2AB6D 60%,#B8742E)}
:root[data-theme="dark"] .contact-art{background:radial-gradient(70% 60% at 85% 0%,rgba(255,214,170,.16),transparent 70%),linear-gradient(160deg,#3A2616,#241710 60%,#150E09)}
.chat-logo{position:absolute;right:-6%;bottom:-10%;height:78%;opacity:.16;color:#2A1D13}
:root[data-theme="dark"] .chat-logo{color:#F6EFE7}
.bubble{position:relative;max-width:78%;padding:12px 18px;border-radius:24px;font-size:.98rem;line-height:1.6;unicode-bidi:plaintext;box-shadow:var(--shadow-s)}
.b-in{align-self:flex-start;background:rgba(255,255,255,.9);color:#2A1D13;border-bottom-left-radius:8px}
.b-out{align-self:flex-end;background:linear-gradient(180deg,#B8742E,#9A5B1A);color:#fff;border-bottom-right-radius:8px}
:root[data-theme="dark"] .b-in{background:rgba(255,236,214,.14);color:var(--text);border:1px solid var(--glass-line)}
.b-typing{align-self:flex-start;display:flex;gap:5px;padding:14px 18px;background:rgba(255,255,255,.9);border-bottom-left-radius:8px}
:root[data-theme="dark"] .b-typing{background:rgba(255,236,214,.14)}
.b-typing i{width:8px;height:8px;border-radius:50%;background:#B8742E;animation:typing 1.2s ease-in-out infinite}
.b-typing i:nth-child(2){animation-delay:.15s}.b-typing i:nth-child(3){animation-delay:.3s}
@keyframes typing{0%,60%,100%{transform:translateY(0);opacity:.45}30%{transform:translateY(-5px);opacity:1}}
.js .reveal .bubble{opacity:0;transform:translateY(14px) scale(.96);transition:opacity .6s var(--out),transform .7s var(--spring)}
.js .reveal.in .bubble{opacity:1;transform:none}
.js .reveal.in .b-out{transition-delay:.45s}.js .reveal.in .b-typing{transition-delay:.9s}
.list-card{display:flex;flex-direction:column;justify-content:center;padding:8px}
.row{display:flex;align-items:center;gap:16px;padding:16px;border-radius:22px;transition:background .2s ease,transform .4s var(--spring)}
.row:hover{background:var(--accent-soft)}
.row:active{transform:scale(.97)}
.row-text{display:grid;flex:1;min-width:0}
.row-text small{color:var(--text-3);font-size:.8rem;line-height:1.5}
.row-text b{font-weight:600;font-size:1.02rem;overflow-wrap:anywhere;text-align:start}
.row .chev{color:var(--text-3);width:18px;height:18px}

/* ---------- Footer ---------- */
.footer{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:16px 24px;padding-block:36px 48px;border-top:1px solid var(--line);color:var(--text-2);font-size:.92rem}
.back-top{display:inline-flex;align-items:center;gap:6px;font-weight:600;color:var(--accent-strong)}
.back-top .ic{width:16px;height:16px}
.copy{flex-basis:100%;color:var(--text-3);text-align:center;font-size:.8rem}

/* ---------- Tab bar (mobile) ---------- */
.tabbar{display:none}

/* ---------- Bottom sheet ---------- */
.sheet-backdrop{position:fixed;inset:0;z-index:80;background:rgba(20,12,6,.45);opacity:0;visibility:hidden;transition:opacity .4s ease,visibility 0s linear .4s}
.sheet{position:fixed;left:0;right:0;bottom:0;margin-inline:auto;z-index:90;width:min(760px,100%);max-height:90vh;max-height:90dvh;background:var(--surface);border-radius:34px 34px 0 0;border:1px solid var(--line);border-bottom:0;box-shadow:0 -24px 70px -20px rgba(0,0,0,.45);transform:translateY(105%);visibility:hidden;transition:transform .6s var(--ease),visibility 0s linear .6s;display:flex;flex-direction:column;touch-action:pan-y}
body.sheet-open .sheet-backdrop{opacity:1;visibility:visible;transition:opacity .4s ease}
body.sheet-open .sheet{transform:none;visibility:visible;transition:transform .6s var(--ease)}
body.sheet-open{overflow:hidden}
.grabber{width:42px;height:5px;border-radius:3px;background:var(--text-3);opacity:.35;margin:10px auto 0;flex:none}
.sheet-close{position:absolute;top:14px;inset-inline-end:14px;z-index:2;background:var(--glass);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px)}
.sheet-scroll{overflow-y:auto;overscroll-behavior:contain;min-height:0;padding:14px 22px calc(32px + env(safe-area-inset-bottom));display:flex;flex-direction:column;align-items:flex-start;gap:14px}
.sheet-scroll>*{flex:none;max-width:100%}
.sheet-head{display:flex;align-items:center;gap:14px;width:100%;padding-inline-end:52px}
.app-ic{width:76px;height:76px;border-radius:22px;flex:none;background:var(--ic) center/cover;display:grid;place-items:center;color:#fff;box-shadow:0 10px 22px -10px rgba(0,0,0,.5),inset 0 0 0 1px rgba(255,255,255,.18)}
.app-ic .ic{width:34px;height:34px}
.sheet-head-text{display:grid;gap:8px;justify-items:start}
.sheet-visual{width:100%;position:relative;border-radius:24px;overflow:hidden;background:var(--bg-2)}
.sheet-lead{font-weight:600;color:var(--text)!important;font-size:1.05rem}
.sheet-scroll p{color:var(--text-2)}
.sheet-sub{font-size:.95rem;font-weight:700;color:var(--text-3);margin-top:8px}
.feature-list li{align-items:flex-start}.feature-list .sq{margin-top:2px}
.kv{width:100%;border-radius:22px;background:var(--surface-2);border:1px solid var(--line);overflow:hidden}
.kv div{display:flex;justify-content:space-between;gap:16px;padding:12px 16px}
.kv div+div{border-top:1px solid var(--line)}
.kv dt{color:var(--text-3);font-size:.9rem}.kv dd{font-weight:600;font-size:.92rem;text-align:end}
.sheet-open .sheet-scroll>*{animation:rise .7s var(--out) both}
.sheet-open .sheet-scroll>:nth-child(2){animation-delay:.05s}.sheet-open .sheet-scroll>:nth-child(n+3){animation-delay:.1s}
.sheet-open .feature-list li{animation:rise .6s var(--out) both;animation-delay:calc(var(--k,0) * 60ms + 200ms)}
.gallery-wrap{width:100%;display:grid;gap:14px}
.gallery{display:flex;gap:14px;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;padding:4px 22px 14px;margin-inline:-22px;width:calc(100% + 44px);scrollbar-width:none;overscroll-behavior-x:contain}
.gallery::-webkit-scrollbar{display:none}
.shot{flex:none;scroll-snap-align:center;margin:0;display:grid;gap:8px;justify-items:center}
.shot .tscale{width:min(560px,80vw);border-radius:18px;box-shadow:var(--shadow);border:1px solid var(--line)}
.shot .phone-wrap{width:min(210px,54vw)}
.shot figcaption{font-size:.8rem;color:var(--text-3);font-weight:600}

/* ---------- Responsive ---------- */
@media (max-width:980px){
  .tool-grid{grid-template-columns:repeat(2,1fr)}
  .about-card{grid-template-columns:1fr}.about-art{min-height:340px}
  .contact-grid{grid-template-columns:1fr}.contact-art{min-height:300px}
}
@media (max-width:820px){
  .main-nav,.header-cta{display:none}
  .site-header{height:58px;border-radius:24px;padding-inline:16px 8px}
  .logo{height:32px}.brand-name{font-size:.95rem}
  body{padding-bottom:calc(var(--tab-h) + 24px + env(safe-area-inset-bottom))}
  .hero{grid-template-columns:1fr;padding-top:104px;gap:36px}
  h1{max-width:none}
  .hero-art{max-width:400px}
  .chip{font-size:.82rem}.chip-a{left:8px;top:22%}.chip-b{right:8px;bottom:18px}
  .project-grid{grid-template-columns:1fr}
  .project-wide{flex-direction:column}
  .project-wide .project-visual{min-height:0}
  .project-wide .project-visual .cover{position:relative;inset:auto;aspect-ratio:3/2;height:auto}
  .tabbar{display:grid;grid-template-columns:repeat(4,1fr);position:fixed;z-index:60;left:12px;right:12px;bottom:max(10px,env(safe-area-inset-bottom));height:var(--tab-h);padding:6px;border-radius:30px;direction:ltr;
    background:var(--glass);box-shadow:var(--shadow);-webkit-backdrop-filter:saturate(200%) blur(26px);backdrop-filter:saturate(200%) blur(26px);
    transition:left .6s var(--spring),right .6s var(--spring),height .5s var(--spring),border-radius .5s var(--spring)}
  .tabbar::before{content:"";position:absolute;inset:0;border-radius:inherit;padding:1px;pointer-events:none;background:linear-gradient(140deg,var(--rim-a),var(--rim-b) 40%,var(--rim-c));-webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask:linear-gradient(#000 0 0) content-box exclude,linear-gradient(#000 0 0)}
  .tab{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;border-radius:24px;color:var(--text-3);font-size:.7rem;font-weight:600;padding:0;min-width:0;transition:color .3s ease,background .3s ease,transform .4s var(--spring)}
  .tab .ic{width:23px;height:23px;transition:transform .5s var(--spring)}
  .tab span{transition:opacity .25s ease,max-height .4s var(--ease);max-height:18px;overflow:hidden}
  .tab:active{transform:scale(.9)}
  .tab.active{color:var(--accent-strong);background:var(--accent-soft)}
  .tab.active .ic{transform:translateY(-1px) scale(1.1)}
  .tabbar.min{left:calc(50% - 128px);right:calc(50% - 128px);height:54px}
  .tabbar.min .tab span{opacity:0;max-height:0}
  .sheet{width:100%}
}
@media (max-width:480px){
  .container{width:calc(100% - 32px)}
  .hero-actions .btn{flex:1 1 100%}
  .tool-grid{gap:12px}.tool{padding:18px}
  .footer{flex-direction:column;align-items:flex-start}
}
@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  .blob,.chip,.pill .dot,.idle-dot{animation:none!important}
  *,*::before,*::after{transition-duration:.01ms!important;animation-duration:.01ms!important}
  .js .reveal{opacity:1;transform:none}.w{opacity:1;transform:none}
}

